            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "garment_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Garment Ids",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "uid": {
            "format": "uuid",
            "title": "Uid",
            "type": "string"
          }
        },
        "required": [
          "uid",
          "name",
          "garment_ids",
          "created_at"
        ],
        "title": "OutfitPublic",
        "type": "object"
      },
      "PhotoPublic": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "height": {
            "title": "Height",
            "type": "integer"
          },
          "uid": {
            "format": "uuid",
            "title": "Uid",
            "type": "string"
          },
          "width": {
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "width",
          "height",
          "uid",
          "created_at"
        ],
        "title": "PhotoPublic",
        "type": "object"
      },
      "UserCreate": {
        "properties": {
          "email": {
            "examples": [
              "joao@example.com"
            ],
            "format": "email",
            "maxLength": 255,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "description": "Mínimo de 8 caracteres e máximo de 72 bytes. Senhas comuns e senhas que contêm o username ou o e-mail são recusadas.",
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "description": "Letras, números, `_`, `.` ou `-`. A grafia é preservada, mas a unicidade não diferencia maiúsculas.",
            "examples": [
              "Joao.Silva"
            ],
            "maxLength": 255,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ],
        "title": "UserCreate",
        "type": "object"
      },
      "UserPublic": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "uid": {
            "format": "uuid",
            "title": "Uid",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "uid",
          "username",
          "email",
          "created_at"
        ],
        "title": "UserPublic",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
