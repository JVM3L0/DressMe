            "description": "Nome do conjunto.",
            "examples": [
              "Look de sexta"
            ],
            "maxLength": 60,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "garment_ids"
        ],
        "title": "OutfitInput",
        "type": "object"
      },
      "OutfitPublic": {
        "properties": {
