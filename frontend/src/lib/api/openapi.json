{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthcheckResponse": {
        "properties": {
          "status": {
            "const": "healthy",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthcheckResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "examples": [
              "joao@example.com"
            ],
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "UserCreate": {
        "properties": {
          "email": {
            "examples": [
              "joao@example.com"
            ],
            "format": "email",
            "maxLength": 255,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "description": "Mínimo de 8 caracteres e máximo de 72 bytes. Senhas comuns e senhas que contêm o username ou o e-mail são recusadas.",
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "description": "Letras, números, `_`, `.` ou `-`. A grafia é preservada, mas a unicidade não diferencia maiúsculas.",
            "examples": [
              "Joao.Silva"
            ],
            "maxLength": 255,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ],
        "title": "UserCreate",
        "type": "object"
      },
      "UserPublic": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "uid": {
            "format": "uuid",
            "title": "Uid",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "uid",
          "username",
          "email",
          "created_at"
        ],
        "title": "UserPublic",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyCookie": {
        "description": "Sessão criada pelo login.",
        "in": "cookie",
        "name": "virtualfit_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "VirtualFit API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "description": "Inicia a sessão num cookie `HttpOnly`: o JavaScript da página não lê o\ntoken, então um XSS não consegue roubá-lo. `SameSite=Strict` impede que\noutros sites enviem requisições com a sessão (CSRF).",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "E-mail ou senha incorretos."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Limite de tentativas por IP atingido."
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Encerra a sessão neste navegador. O token é stateless e continua\nválido até expirar (sem lista de revogação na PoC, ADR-0006).",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/healthcheck/": {
      "get": {
        "operationId": "healthcheck_healthcheck__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthcheckResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthcheck",
        "tags": [
          "healthcheck"
        ]
      }
    },
    "/users/": {
      "post": {
        "operationId": "create_user_users__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "E-mail ou username já registrado."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Limite de cadastros por IP atingido."
          }
        },
        "summary": "Create User",
        "tags": [
          "users"
        ]
      }
    },
    "/users/me": {
      "get": {
        "operationId": "read_current_user_users_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Sem sessão ou com sessão expirada."
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "Read Current User",
        "tags": [
          "users"
        ]
      }
    }
  }
}
