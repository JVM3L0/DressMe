{
  "components": {
    "schemas": {
      "Body_add_garment_garments__post": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/GarmentCategory"
          },
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "Imagem JPEG ou PNG de até 10 MB.",
            "title": "File",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "file",
          "category"
        ],
        "title": "Body_add_garment_garments__post",
        "type": "object"
      },
      "Body_upload_photo_photos__post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "Imagem JPEG ou PNG de até 10 MB.",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_photo_photos__post",
        "type": "object"
      },
      "GarmentCategory": {
        "description": "Categoria da peça pela região do corpo, que define a camada e a posição\ninicial no provador. Os rótulos em português ficam no frontend.",
        "enum": [
          "top",
          "outerwear",
          "bottom",
          "one_piece",
          "footwear",
          "accessory"
        ],
        "title": "GarmentCategory",
        "type": "string"
      },
      "GarmentPublic": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/GarmentCategory"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "height": {
            "title": "Height",
            "type": "integer"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "uid": {
            "format": "uuid",
            "title": "Uid",
            "type": "string"
          },
          "width": {
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "width",
          "height",
          "uid",
          "category",
          "name",
          "created_at"
        ],
        "title": "GarmentPublic",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthcheckResponse": {
        "properties": {
          "status": {
            "const": "healthy",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthcheckResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "examples": [
              "joao@example.com"
            ],
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
