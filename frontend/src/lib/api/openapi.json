                  "title": "Response List Garments Garments  Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Sem sessão ou com sessão expirada."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "List Garments",
        "tags": [
          "garments"
        ]
      },
      "post": {
        "description": "Adiciona uma peça ao guarda-roupa. PNG com fundo transparente fica\nmelhor no provador.",
        "operationId": "add_garment_garments__post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_add_garment_garments__post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GarmentPublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Sem sessão ou com sessão expirada."
          },
          "413": {
            "description": "A imagem passa de 10 MB."
          },
          "415": {
            "description": "O arquivo não é uma imagem JPEG ou PNG válida."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Limite de envios por IP atingido."
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "Add Garment",
        "tags": [
          "garments"
        ]
      }
    },
