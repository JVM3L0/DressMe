# Copie para `.env` e ajuste os valores: cp .env.example .env

# Banco usado pelo docker compose (credenciais definidas na criação do volume)
POSTGRES_USER=dressme
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=dressme
# POSTGRES_PORT=5432

# Conexão da aplicação rodando fora do Docker (mesmas credenciais acima)
DATABASE_URL=postgresql+asyncpg://dressme:troque-esta-senha@localhost:5432/dressme

# Chave dos tokens JWT (mínimo de 32 caracteres). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# Opcional
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# ECHO_SQL=true
# TEST_DATABASE_URL=postgresql+asyncpg://dressme:troque-esta-senha@localhost:5432/dressme_test
