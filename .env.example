# Copie para `.env` e ajuste os valores: cp .env.example .env

# Banco usado pelo docker compose (credenciais definidas na criação do volume)
POSTGRES_USER=dressme
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=dressme
# POSTGRES_PORT=5432

# Conexão da aplicação rodando fora do Docker (mesmas credenciais acima)
DATABASE_URL=postgresql+asyncpg://dressme:troque-esta-senha@localhost:5432/dressme

# Chave dos tokens JWT (mínimo de 32 caracteres). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# Opcional
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# ECHO_SQL=true

# Rate limiting (por IP)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_SIGNUP=5/minute
# Com várias instâncias da API, use um armazenamento compartilhado:
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379
# Atrás de um proxy (deploy), informe os IPs confiáveis para o uvicorn usar
# o IP real do cliente (X-Forwarded-For). "*" só se a API não for acessível
# diretamente, sem passar pelo proxy.
# FORWARDED_ALLOW_IPS=*
# TEST_DATABASE_URL=postgresql+asyncpg://dressme:troque-esta-senha@localhost:5432/dressme_test
